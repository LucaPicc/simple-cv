---
import { basics, skills } from "@cv"

interface Props {
    title: string
}

const { title } = Astro.props

const { image } = basics

const keywordsMeta = new Set();

skills.forEach(({name, keywords}) => {
    keywordsMeta.add(name)
    keywords.forEach((key) => {
        keywordsMeta.add(key)
    })
})

---
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{title}</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
        <link rel="preload" as="image" href={image}/>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">
        <meta name="author" content="Luca Piccinini"/>
        <meta name="keywords" content={Array.from(keywordsMeta).join(",")}/>
        <meta name="description" content={basics.summary}/>
    </head>
    <body>
        <slot/>
    </body>
</html>

<style is:global>
    :root {
        --color-text: #17202a;
        --color-muted: #5c6672;
        --color-subtle: #eef1f4;
        --color-border: #d9dee5;
        --color-surface: #ffffff;
        --color-surface-soft: #f7f9fb;
        --color-accent: #2563eb;
        --color-accent-soft: #e8f0ff;
        --shadow-sm: 0 8px 24px rgba(15, 23, 42, 0.06);
    }

    html {
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        letter-spacing: 0;
        line-height: 1.55;
    }

    body,
    figure {
        margin: 0;
        padding: 0;
    }

    html,
    body {
        background: #f3f6f9;
        color: var(--color-text);
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

  *,
  *::before,
  *::after {
        box-sizing: border-box;
    }

    h1,
    h2,
    h3,
    h4 {
        margin: 0;
        line-height: 1.2;
    }

    p {
        margin: 0;
    }

    section {
        width: 100%;
    }

    section + section {
        margin-top: 2rem;
    }

    section > h2 {
        display: flex;
        align-items: center;
        width: 100%;
        gap: .75rem;
        margin-bottom: 1rem;
        color: var(--color-text);
        font-size: .82rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    section > h2::after {
        content: "";
        flex: 1;
        height: 1px;
        background: var(--color-border);
    }

    .print {
        display: none !important;
    }

    @media print {
        @page {
            size: A4;
            margin: 10mm;
        }

        html {
            font-size: 11.5px;
        }

        body {
            background: #fff !important;
            color: #111;
            print-color-adjust: exact;
            -webkit-print-color-adjust: exact;
        }

        .no-print {
            display: none !important;
        }

        .print {
            display: block !important;
        }

        section + section {
            margin-top: 1.15rem;
        }

        section > h2 {
            margin-bottom: .75rem;
            font-size: .8rem;
        }
    }
</style>
