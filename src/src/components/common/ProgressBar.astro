---
interface Props {
    level: string
}
const { level } = Astro.props;
const intLevel = parseInt(level)
---


<div class="progress-bar">
    <div class={`progress-fill`} style={`width: ${intLevel}%; background-color: #5794ba;`}></div>
</div>
<div class="level">{level}</div>

<style>
    .progress-bar {
        width: 100%;
        height: 6px;
        background-color: var(--color-subtle);
        border-radius: 999px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        border-radius: inherit;
        transition: width 0.3s ease;
    }

    .level {
        text-align: end;
        margin-top: .2rem;
        color: var(--color-muted);
        font-size: .72rem;
        font-weight: 700;
    }

    @media print {
        .progress-bar {
            height: 5px;
        }

        .level {
            display: block;
        }
    }
</style>
