---
const { location } = Astro.props;
---

<div>
    <p>{location.city} - {location.region} {location.countryCode}</p>
</div>
<style>
    p {
        margin-top: .35rem;
        font-size: .9rem;
        display: flex;
        flex-direction: row;
        align-items: center;
        font-weight: 500;
        color: var(--color-muted);
    }

    @media print {
        p {
            margin-top: .2rem;
            font-size: .82rem;
        }
    }
</style>
