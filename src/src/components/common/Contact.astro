---
import MailIcon from "@/icons/MailIcon.astro"
import PhoneIcon from "@/icons/PhoneIcon.astro"
import type {SocialIcon} from "@/types"
import GithubIcon from "@/icons/GithubIcon.astro"
import type {Profiles} from "@/cv";
import LinkedinIcon from "@/icons/LinkedinIcon.astro"

interface Props {
    email: string
    name: string
    phone: string
    profiles: Profiles[]
}

const {email, name, phone, profiles} = Astro.props


const ProfilesIcons: SocialIcon = {
    "Github": GithubIcon,
    "Linkedin": LinkedinIcon
}


---

<div class="contact">
    <a
    href={`mailto:${email}`}
    title={`Send an email to ${name} at ${email}`}
    target="_blank"
    rel="noopener noreferrer"
    ><MailIcon width="1.3rem" height="1.3rem"/></a>
    <a
        href={`tel:${phone}`}
        title={`Call ${name} at ${phone}`}
        target="_blank"
        rel="noopener noreferrer"
    ><PhoneIcon width="1.3rem" height="1.3rem"/></a>
    {
        profiles.map(({ network, url }) => {
            const ProfileIcon = ProfilesIcons[network]
            return (
                <a 
                    href={url}
                    title={`Visit ${name}'s ${network} profile`}
                    target="_blank"
                    rel="noopener noreferrer"
                ><ProfileIcon width="1.3rem" height="1.3rem"/></a>
            )
        })
    }
</div>

<style>
    .contact {
        display: flex;
        flex-direction: row;
        gap: .35rem;
        flex-wrap: wrap;
    }

    .contact a {
        color: var(--color-muted);
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border: 1px solid var(--color-border);
        border-radius: 6px;
        cursor: pointer;
        transition: background .2s ease, border-color .2s ease, color .2s ease, transform .2s ease;
    }

    .contact a:hover {
        border-color: var(--color-accent);
        background: var(--color-accent-soft);
        color: var(--color-accent);
        transform: translateY(-1px);
    }

    @media print {
        .contact {
            gap: .25rem;
        }

        .contact a {
            width: 1.6rem;
            height: 1.6rem;
            border-radius: 4px;
        }
    }
</style>
