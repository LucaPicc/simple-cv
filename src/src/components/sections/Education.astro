---
import Section from "../Section.astro";
import EducationIcon from "@/icons/EducationIcon.astro";

type EducationItem = {
    url: string
    institution: string
    startDate: string
    endDate: string | null
    area: string
}

type EducationLabels = {
    sectionTitle: string
    view: string
    current: string
}

interface Props {
    education: EducationItem[]
    labels?: EducationLabels
}

const {
    education,
    labels = {
        sectionTitle: "Education",
        view: "View",
        current: "current"
    }
} = Astro.props as Props;
---

<Section title={labels.sectionTitle}>
    <ul>
        {
            education.map(({ url, institution, startDate, endDate, area }) => (
                <li>
                    <article>
                        <header>
                            <div>
                                <div class="title">
                                    <EducationIcon width="16px" height="20px" />
                                    <h3>
                                        <a
                                            href={url}
                                            title={`${labels.view} ${institution}`}
                                            target="_blank"
                                        >
                                            {institution}
                                        </a>
                                    </h3>
                                </div>
                                <h4>{area}</h4>
                            </div>
                            <div>
                                <time datetime={startDate} data-title={startDate}>
                                    {startDate}
                                </time>
                                {" - "}
                                <time datetime={endDate} data-title={endDate}>
                                    {endDate || labels.current}
                                </time>
                            </div>
                        </header>
                    </article>
                </li>
            ))
        }
    </ul>
</Section>
<style>
    ul {
        display: flex;
        flex-direction: column;
        align-items: start;
        justify-content: center;
        gap: 1rem;
        width: 100%;
    }

    article {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        width: 100%;
        padding: 1rem 1.15rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-surface);
    }

    article h3 {
        font-size: 1.18rem;
        font-weight: 800;
        color: var(--color-text);
    }

    article a {
        color: var(--color-text);
    }

    article a:hover {
        text-decoration: underline;
    }

    article h4 {
        color: var(--color-muted);
        font-size: .94rem;
        font-weight: 700;
    }

    header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        width: 100%;
        gap: 1rem;
    }

    time {
        color: var(--color-muted);
        font-size: 0.84rem;
        font-weight: 600;
        white-space: nowrap;
        cursor: default;
    }

    footer p {
        margin: 0;
        text-align: justify;
    }

    .title {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: .45rem;
    }

    .title h3 {
        margin-left: 0;
    }

    @media (width <= 1000px) {
        header {
            flex-direction: column;
            gap: .35rem;
        }
    }

    @media print {
        article {
            padding: .75rem .85rem;
            border: 1px solid var(--color-border);
            border-radius: 8px;
            background: var(--color-surface);
            break-inside: auto;
        }

        article h3 {
            font-size: 1rem;
        }

        article h4,
        time {
            font-size: .78rem;
        }
    }
</style>
