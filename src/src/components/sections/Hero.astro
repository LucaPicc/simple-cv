---
import Section from "@/components/Section.astro"
import CodeIcon from "@/icons/CodeIcon.astro"
import Contact from "../common/Contact.astro"
import Location from "../common/Location.astro"

const { basics } = Astro.props
const {name, label, image, email, phone, summary, profiles} = basics

---
<Section>
    <div class="container">
        <figure>
            <img src={image} alt={name} />
        </figure>     
        <div class="info">
            <h1>{name}</h1>
            <Contact email={email} name={name} profiles={profiles} phone={phone}/>
            <div class="label">
                <CodeIcon width="1rem" height="1rem"/>
                <h2>{label}</h2>
            </div>
            <Location location={basics.location}/>
            <p class="summary">{summary}</p>
        </div>
    </div>
</Section>

<style>
    .container {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 1.5rem;
        margin-bottom: 2rem;
        padding-bottom: .5rem;
    }

    img {
        aspect-ratio: 1 / 1;
        object-fit: cover;
        width: 132px;
        border-radius: 8px;
        border: 1px solid var(--color-border);
        margin-bottom: 0;
    }
    
    .info {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        min-width: 0;
    }

    h1 {
        color: var(--color-text);
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 800;
        margin-top: 0;
        margin-bottom: .35rem;
    }

    h2 {
        color: var(--color-muted);
        font-size: 1rem;
        font-weight: 700;
        margin-top: 0;
        display: flex;
    }

    .summary {
        margin-top: .85rem;
        color: var(--color-muted);
        text-align: left;
        max-width: 78ch;
    }

    .label {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: .35rem;
        margin-top: .35rem;
        color: var(--color-accent);
    }

    @media (width <= 700px) {
        .container {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .info {
            align-items: center;
            text-align: center;
        }

        .summary {
            text-align: left;
        }
    }

    @media print {
        .container {
            gap: 1rem;
            margin-bottom: 1rem;
            padding-bottom: .5rem;
            align-items: flex-start;
        }

        img {
            width: 82px;
            border-radius: 6px;
        }

        h1 {
            font-size: 2.1rem;
            margin-bottom: .2rem;
        }

        h2 {
            font-size: .9rem;
        }

        .summary {
            margin-top: .55rem;
            font-size: .9rem;
            line-height: 1.35;
        }
    }

</style>
