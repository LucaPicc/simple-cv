---
import type { SocialIcon } from "@/types";
import Section from "../Section.astro";
import PythonIcon from "@/icons/PythonIcon.astro";
import DockerIcon from "@/icons/DockerIcon.astro";
import JavaScriptIcon from "@/icons/JavaScriptIcon.astro";
import CodeIcon from "@/icons/CodeIcon.astro";
import HTMLIcon from "@/icons/HTMLIcon.astro";
import CSSIcon from "@/icons/CSSIcon.astro";
import ReactIcon from "@/icons/ReactIcon.astro";
import NodeJSIcon from "@/icons/NodeJSIcon.astro";
import DjangoIcon from "@/icons/DjangoIcon.astro";
import MongoDBIcon from "@/icons/MongoDBIcon.astro";
import PostgreSQLIcon from "@/icons/PostgreSQLIcon.astro";
import NextJSIcon from "@/icons/NextJSIcon.astro";
import TypescriptIcon from "@/icons/TypescriptIcon.astro";
import RedisIcon from "@/icons/RedisIcon.astro";
import SocketIOIcon from "@/icons/SocketIOIcon.astro";
import MySQLIcon from "@/icons/MySQLIcon.astro";
import DRFIcon from "@/icons/DRFIcon.astro";
import ProgressBar from "../common/ProgressBar.astro";
import FastAPIIcon from "@/icons/FastAPIIcon.astro";
import SQLIcon from "@/icons/SQLIcon.astro";
import ExpressJSIcon from "@/icons/ExpressJSIcon.astro";
import CIcon from "@/icons/CIcon.astro";

const TecIcons: SocialIcon = {
    "Python": PythonIcon,
    "Docker": DockerIcon,
    "Javascript": JavaScriptIcon,
    "HTML": HTMLIcon,
    "CSS": CSSIcon,
    "React": ReactIcon,
    "Node JS": NodeJSIcon,
    "Django": DjangoIcon,
    "MongoDB": MongoDBIcon,
    "PostgreSQL": PostgreSQLIcon,
    "Next JS": NextJSIcon,
    "TypeScript": TypescriptIcon,
    "Redis": RedisIcon,
    "Socket.io": SocketIOIcon,
    "MySQL": MySQLIcon,
    "Django Rest Framework": DRFIcon,
    "FastAPI": FastAPIIcon,
    "SQL": SQLIcon,
    "Express JS": ExpressJSIcon,
    "C": CIcon
}

type SkillItem = {
    name: string
    level: string
}

type SkillLabels = {
    sectionTitle: string
}

interface Props {
    skills: SkillItem[]
    labels?: SkillLabels
}

const {
    skills,
    labels = {
        sectionTitle: "Skills"
    }
} = Astro.props as Props;
---

<Section title={labels.sectionTitle}>
    <ul>
        {
            skills.map(({name, level}) => {
                const TecIcon = TecIcons[name] ? TecIcons[name] : CodeIcon
                
                return (
                    <li>
                        <div class="item">
                            <TecIcon width="1rem" height="1rem"/><span>{name}</span>
                        </div>
                        <ProgressBar level={level}/>
                    </li>
                )
            })
        }
    </ul>
</Section>

<style>
    ul {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: .85rem;
        flex-wrap: wrap;
        width: 100%;
    }

    li {
        min-width: 0;
        padding: .85rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-surface);
    }

    .item {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: .35rem;
        margin-bottom: .45rem;
        color: var(--color-accent);
    }

    .item span {
        margin-left: 0;
        color: var(--color-text);
        font-size: .95rem;
        font-weight: 800;
    }

    @media print {
        ul {
            grid-template-columns: repeat(4, 1fr);
            gap: .45rem;
        }

        li {
            padding: .65rem;
            border: 1px solid var(--color-border);
            border-radius: 8px;
            background: var(--color-surface);
        }

        .item {
            margin-bottom: .25rem;
        }

        .item span {
            font-size: .82rem;
        }
    }
</style>
