---
import GlobeIcon from "@/icons/GlobeIcon.astro";
import Section from "../Section.astro";

type LanguageItem = {
    language: string
    fluency: string
}

type LanguageLabels = {
    sectionTitle: string
}

interface Props {
    languages: LanguageItem[]
    labels?: LanguageLabels
}

const {
    languages,
    labels = {
        sectionTitle: "Languages"
    }
} = Astro.props as Props;
---
<Section title={labels.sectionTitle}>
    <ul>
        {
            languages.map(({language, fluency}) => (
                <li>
                    <article>
                        <header><GlobeIcon width="1rem" height="1rem" /><h3>{language}</h3></header>
                        <footer><p>{fluency}</p></footer>
                    </article>
                </li>
            ))
        }
    </ul>
</Section>

<style>

    ul {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
    }

    li {
        min-width: 160px;
    }

    article {
        height: 100%;
        padding: .85rem 1rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-surface);
    }

    article header {
        margin-bottom: 0px;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: .4rem;
        color: var(--color-accent);
    }

    article header h3 {
        color: var(--color-text);
        font-size: 1.05rem;
        margin-bottom: 1px;
        font-weight: 800 !important;
    }

    article footer {
        margin-top: 0px;
    }

    article footer p {
        margin-top: .2rem;
        color: var(--color-muted);
        font-weight: 600;
    }

    @media print {
        ul {
            gap: .4rem;
        }

        li {
            min-width: 120px;
        }

        article {
            padding: .65rem .75rem;
            border: 1px solid var(--color-border);
            border-radius: 8px;
            background: var(--color-surface);
        }

        article header h3 {
            font-size: .95rem;
        }

        article footer p {
            font-size: .82rem;
        }
    }

</style>
