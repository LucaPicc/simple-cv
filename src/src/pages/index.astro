---
import Layout from "@/layouts/Layout.astro"
import Hero from "@/components/sections/Hero.astro"
import Experiencie from "@/components/sections/Experiencie.astro"
import Skill from "@/components/sections/Skill.astro"
import Education from "@/components/sections/Education.astro"
import Languages from "@/components/sections/Languages.astro"
import DownloadIcon from "@/icons/DownloadIcon.astro"
---

<Layout title="Luca Piccinini CV">
	<main>
		<Hero/>
		<Experiencie/>
		<Education/>
		<Languages/>
		<Skill/>
		<div class="download-container no-print">
			<button class="download" type="button" data-download-pdf>
				<DownloadIcon width="1rem" height="1rem"/>
				<span>Descargar PDF</span>
			</button>
		</div>
	</main>
</Layout>

<script>
	const downloadButton = document.querySelector("[data-download-pdf]");

	downloadButton?.addEventListener("click", () => {
		window.print();
	});
</script>

<style>
	main {
		padding: 5rem 20rem;
		margin: auto;
		width: 100%;
	}

	.download-container {
		display: flex;
		justify-content: center;
		width: 100%;
		margin-top: 2rem;
	}

	.download {
		display: inline-flex;
		align-items: center;
		gap: .35rem;
		min-height: 2.25rem;
		padding: .45rem .75rem;
		border: 1px solid #222;
		border-radius: 6px;
		background: #fff;
		color: #111;
		font: inherit;
		cursor: pointer;
	}

	.download:hover,
	.download:focus-visible {
		background: #111;
		color: #fff;
	}

	@media (width <= 1200px) {
		main {
			padding: 5rem 15rem;
		}
	}

	@media (width <= 800px) {
		main {
			padding: 5rem 5rem;
		}
	}

	@media (width <= 700px) {
		main {
			padding: 2rem;
		}
	}

	@media print {
		main {
			width: 100%;
			margin: 0;
			padding: 0;
		}
	}
</style>
